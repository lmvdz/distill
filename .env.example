# Every setting has a working default; override only what you need.
OMNIROUTE_URL=http://127.0.0.1:20128/v1
DISTILL_MODEL=agy/gemini-3.8-flash-high
# Model for the steps that send no clip (prescreen, technique grouping, entry text). Defaults to
# DISTILL_MODEL. `claude:<model>` or `codex:<model>` runs that CLI on its subscription instead
# of OmniRoute, e.g. claude:opus or codex:gpt-6.1-sol. Neither can watch video.
# DISTILL_TEXT_MODEL=claude:opus
# Most CLI calls running at once.
DISTILL_TEXT_CONCURRENCY=2
DISTILL_DATA=data
DISTILL_WORKERS=2
# Most calls in flight to OmniRoute at once. The pipeline halves this when OmniRoute says
# busy and creeps back up after successes.
DISTILL_MODEL_CONCURRENCY=4
DISTILL_DAILY_CAP=500
# Screen quality 1-5 a video needs. The score wobbles by about a point between runs, and
# verification removes weak claims anyway, so this only keeps out clear junk.
DISTILL_KEEP_THRESHOLD=2
# Browser yt-dlp reads cookies from, for Instagram. Empty to disable.
DISTILL_COOKIES_BROWSER=firefox
# Videos older than this are dropped before download. Techniques age slowly; menus age fast,
# and the screen already drops click-alongs, so five years.
DISTILL_MAX_AGE_DAYS=1825

# Optional `distill research` (Jev). EmbeddingGemma search runs locally without these.
# Read only research keys from an external env file; no credential copying needed.
# DISTILL_RESEARCH_KEYS_FILE=C:/path/to/keys.env
# Experiential's native Jev gateway uses jev-latest:free when this key is present.
# EXPERIENTIAL_API_KEY=
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# TEXT_MODEL_API_KEY=
# TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# TEXT_MODEL=inception/mercury-2.5
# TEXT_MODEL_REASONING=none
# Local embeddings: auto selects GPU and falls back to CPU on memory pressure.
# DISTILL_SEARCH_DEVICE=auto
